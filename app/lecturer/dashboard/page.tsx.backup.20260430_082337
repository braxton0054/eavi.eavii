'use client';

import { useEffect, useState } from 'react';
import Image from 'next/image';
import Link from 'next/link';
import { createClient } from '@/lib/client';
import { useRouter } from 'next/navigation';
import { getAllUnits, getCourseTypeConfig } from '@/lib/course-structure';

export default function LecturerDashboard() {
  const router = useRouter();
  const [supabase, setSupabase] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [lecturerInfo, setLecturerInfo] = useState<any>(null);
  const [assignments, setAssignments] = useState<any[]>([]);
  const [showSetup, setShowSetup] = useState(false);
  const [viewMode, setViewMode] = useState<'setup' | 'dashboard' | 'marks'>('setup');
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');

  useEffect(() => {
    setSupabase(createClient());
  }, []);

  // Setup form data
  const [setupData, setSetupData] = useState({
    campus: '',
    department: '',
    course: '',
    classId: '',
    units: [] as string[]
  });

  // Available classes for selected course
  const [availableClasses, setAvailableClasses] = useState<any[]>([]);
  // Available units for selected course
  const [availableUnits, setAvailableUnits] = useState<any[]>([]);
  const [loadingUnits, setLoadingUnits] = useState(false);
  const [expandedModules, setExpandedModules] = useState<Set<number>>(new Set());
  
  // Unit details cache for dashboard display
  const [unitDetailsCache, setUnitDetailsCache] = useState<Map<string, any>>(new Map());
  
  // Classes detected from enrolled students for each assignment
  const [assignmentClasses, setAssignmentClasses] = useState<Map<string, string[]>>(new Map());

  // Courses data from Supabase
  const [courses, setCourses] = useState<any[]>([]);

  // Marks input form data
  const [marksData, setMarksData] = useState({
    selectedAssignmentId: '',
    selectedCourse: '',
    selectedClass: '',
    selectedUnit: '',
    semester: '',
    examType: '',
    marks: [] as any[]
  });

  // Track if semester should be locked (when unit clicked from dashboard)
  const [lockSemester, setLockSemester] = useState(false);

  // Track if unit should be locked (when unit clicked from dashboard)
  const [lockUnit, setLockUnit] = useState(false);

  // Load students when course, unit, semester, and exam type are selected
  useEffect(() => {
    if (!supabase) return;

    const loadStudents = async () => {
      if (marksData.selectedAssignmentId && marksData.selectedUnit && marksData.semester && marksData.examType) {
        const selectedAssignment = assignments.find(a => a.id === marksData.selectedAssignmentId);
        if (!selectedAssignment) {
          console.log('No assignment found for ID:', marksData.selectedAssignmentId);
          return;
        }

        const campus = selectedAssignment.campus;
        const courseId = selectedAssignment.course_id;
        const className = marksData.selectedClass || selectedAssignment.class_name || '';
        const unitSemester = parseInt(marksData.semester);

        console.log('Loading students for:', { courseId, campus, className, unitSemester, assignmentId: selectedAssignment.id });

        // Debug: Check what students exist for this course (with campus filter)
        const { data: debugStudents } = await supabase
          .from('applications')
          .select('id, full_name, admission_number, class_name, campus, status, course_id, financial_hold')
          .eq('course_id', courseId)
          .ilike('campus', `%${campus}%`);
        console.log('All students for course+campus:', debugStudents);

        // Fetch ALL enrolled students for this course, campus, and class
        let query = supabase
          .from('applications')
          .select('id, full_name, admission_number, current_semester, current_module, class_name')
          .eq('course_id', courseId)
          .ilike('campus', `%${campus}%`)
          .eq('status', 'enrolled')
          .eq('financial_hold', false);

        // Filter by class_name if it's set
        if (className) {
          console.log('Filtering by class_name:', className);
          query = query.eq('class_name', className);
        }

        const { data: studentsData, error: studentsError } = await query;

        if (studentsError) {
          console.error('Error loading students:', studentsError);
          setError(`Failed to load students: ${studentsError.message}`);
          return;
        }

        console.log('Found students:', studentsData?.length || 0);

        if (studentsData) {
          // Fetch existing marks for these students using application_id
          const { data: existingMarks, error: marksError } = await supabase
            .from('exam_marks')
            .select('application_id, marks, cat_marks, end_term_marks')
            .eq('course_id', courseId)
            .eq('unit_code', marksData.selectedUnit)
            .eq('semester', unitSemester)
            .eq('exam_type', marksData.examType)
            .in('application_id', studentsData.map((s: any) => s.id));

          if (marksError) {
            console.error('Error loading existing marks:', marksError);
            // Don't return - continue with empty marks
          }

          // Create a map of existing marks by application_id
          const marksMap = new Map();
          if (existingMarks) {
            existingMarks.forEach((mark: any) => {
              marksMap.set(mark.application_id, mark);
            });
          }

          // Merge student data with existing marks
          setMarksData({
            ...marksData,
            marks: studentsData.map((student: any) => {
              const existingMark = marksMap.get(student.id);  // Use student.id (application_id)
              return {
                application_id: student.id,
                name: student.full_name,
                admission_number: student.admission_number,
                current_semester: student.current_semester,
                current_module: student.current_module,
                marks: existingMark?.marks || 0,
                cat_marks: existingMark?.cat_marks || null,
                end_term_marks: existingMark?.end_term_marks || null
              };
            })
          });
        } else {
          // No students found - set empty array
          setMarksData({
            ...marksData,
            marks: []
          });
        }
      }
    };

    loadStudents();
  }, [marksData.selectedAssignmentId, marksData.selectedCourse, marksData.selectedClass, marksData.selectedUnit, marksData.semester, marksData.examType, assignments, supabase]);

  // Load lecturer assignments into a reusable function
  const loadLecturerAssignments = async (lecturerId: string) => {
    if (!supabase) return;

    const { data: assignmentsData, error: assignmentsError } = await supabase
      .from('lecturer_assignments')
      .select('*')
      .eq('lecturer_id', lecturerId);

    if (assignmentsError) {
      console.error('Error loading assignments:', assignmentsError);
      setError(`Failed to load assignments: ${assignmentsError.message}`);
      return;
    }

    if (assignmentsData && assignmentsData.length > 0) {
      console.log('Found assignments:', assignmentsData.length);
      
      // Load course details for each assignment
      const assignmentsWithCourses = await Promise.all(
        assignmentsData.map(async (assignment: any) => {
          const { data: courseData } = await supabase
            .from('courses')
            .select('name, id')
            .eq('id', assignment.course_id)
            .single();

          // Load units for this assignment
          const { data: assignmentUnits } = await supabase
            .from('lecturer_assignment_units')
            .select('unit_code')
            .eq('assignment_id', assignment.id);

          return {
            ...assignment,
            courses: courseData,
            units: assignmentUnits ? assignmentUnits.map((u: any) => u.unit_code) : []
          };
        })
      );

      console.log('Assignments with courses:', assignmentsWithCourses);
      setAssignments(assignmentsWithCourses);
      setViewMode('dashboard');
    } else {
      console.log('No assignments found, showing setup');
      setShowSetup(true);
      setViewMode('setup');
    }
  };

  // Load units when course is selected
  useEffect(() => {
    if (!supabase || !setupData.course) {
      setAvailableUnits([]);
      return;
    }

    const loadUnits = async () => {
      setLoadingUnits(true);
      console.log('Loading units for course:', setupData.course);

      const { data: unitsData, error: unitsError } = await supabase
        .from('units')
        .select('unit_code, name, module_index, semester_index, unit_type')
        .eq('course_id', setupData.course)
        .order('module_index', { ascending: true })
        .order('semester_index', { ascending: true });

      if (unitsError) {
        console.error('Error loading units:', unitsError);
        setAvailableUnits([]);
      } else {
        console.log('Loaded units:', unitsData?.length || 0);
        setAvailableUnits(unitsData || []);
      }
      setLoadingUnits(false);
    };

    loadUnits();
  }, [supabase, setupData.course]);

  // Load classes for selected course
  const loadClassesForCourse = async (courseId: string) => {
    if (!supabase || !courseId) return;
    
    console.log('Loading classes for course:', courseId);
    const { data: classesData, error: classesError } = await supabase
      .from('classes')
      .select('id, class_name, campus, semester, module_index')
      .eq('course_id', courseId)
      .eq('is_active', true)
      .order('class_name', { ascending: true });
    
    if (classesError) {
      console.error('Error loading classes:', classesError);
      setAvailableClasses([]);
    } else {
      console.log('Loaded classes:', classesData?.length || 0);
      setAvailableClasses(classesData || []);
    }
  };

  // Load unit details for assignments
  useEffect(() => {
    if (!supabase || assignments.length === 0) return;

    const loadUnitDetails = async () => {
      const cache = new Map();
      
      // Get all unique course_ids from assignments
      const courseIds = [...new Set(assignments.map(a => a.course_id))];
      
      for (const courseId of courseIds) {
        const { data: unitsData, error: unitsError } = await supabase
          .from('units')
          .select('unit_code, name, module_index, semester_index')
          .eq('course_id', courseId);
        
        if (unitsError) {
          console.error('Error loading unit details:', unitsError);
          continue;
        }
        
        if (unitsData) {
          console.log(`Loaded ${unitsData.length} units for course ${courseId}`);
          unitsData.forEach(unit => {
            cache.set(unit.unit_code, {
              unit_code: unit.unit_code,
              name: unit.name,
              module_index: unit.module_index,
              semester_index: unit.semester_index
            });
          });
        }
      }
      
      console.log('Unit details cache size:', cache.size);
      setUnitDetailsCache(cache);
    };

    loadUnitDetails();
  }, [supabase, assignments]);

  // Detect classes from enrolled students for each assignment
  useEffect(() => {
    if (!supabase || assignments.length === 0) return;

    const detectClasses = async () => {
      const classesMap = new Map<string, string[]>();
      
      for (const assignment of assignments) {
        // Find unique class_names from enrolled students for this course+campus
        const { data: studentsData } = await supabase
          .from('applications')
          .select('class_name')
          .eq('course_id', assignment.course_id)
          .ilike('campus', `%${assignment.campus}%`)
          .eq('status', 'enrolled')
          .not('class_name', 'is', null)
          .neq('class_name', '');
        
        if (studentsData && studentsData.length > 0) {
          const uniqueClasses = [...new Set(studentsData.map((s: any) => s.class_name))];
          classesMap.set(assignment.id, uniqueClasses);
          console.log(`Assignment ${assignment.id}: Found classes`, uniqueClasses);
        } else {
          classesMap.set(assignment.id, []);
        }
      }
      
      setAssignmentClasses(classesMap);
    };

    detectClasses();
  }, [supabase, assignments]);

  // Load courses from Supabase
  useEffect(() => {
    if (!supabase) return;

    const loadCourses = async () => {
      try {
        // Load courses with departments and course types (short courses loaded separately)
        const { data: coursesData, error: coursesError } = await supabase
          .from('courses')
          .select(`
            *,
            departments (name),
            course_types (
              level,
              enabled,
              min_kcse_grade,
              study_mode,
              duration_months,
              modules (
                module_index,
                exam_body,
                semesters (
                  semester_index,
                  duration_months,
                  fee,
                  practical_fee,
                  internal_exams
                )
              )
            )
          `);

        if (coursesError) {
          console.error('Error loading courses:', coursesError);
          setError(`Failed to load courses: ${coursesError.message || 'Unknown error'}. Please refresh the page.`);
          return;
        }

        if (coursesData) {
          // Map department name to department field for compatibility
          const mappedCourses = coursesData.map((c: any) => ({
            ...c,
            department: c.departments?.name || 'Unknown'
          }));
          console.log('Loaded courses:', mappedCourses.length);
          setCourses(mappedCourses);
        }
      } catch (err: any) {
        console.error('Exception loading courses:', err);
        setError(`Failed to load courses: ${err?.message || 'Unknown error'}. Please refresh the page.`);
      }
    };

    loadCourses();
  }, [supabase]);

  useEffect(() => {
    if (!supabase) return;

    checkAuth();
  }, [supabase, router]);

  const checkAuth = async () => {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        router.push('/login/lecturer');
        return;
      }

      const { data: { user } } = await supabase.auth.getUser();
      if (user) {
        const userMetadata = user.user_metadata;
        if (userMetadata?.role !== 'lecturer') {
          router.push('/login/lecturer');
          return;
        }
        setLecturerInfo(userMetadata);

        // Load lecturer from lecturer_number first to get UUID
        const { data: lecturerData, error: lecturerError } = await supabase
          .from('lecturers')
          .select('id')
          .eq('lecturer_number', userMetadata.lecturer_number || userMetadata.id)
          .single();

        if (lecturerError || !lecturerData) {
          console.error('Error finding lecturer:', lecturerError);
          setError('Lecturer profile not found. Please contact admin.');
          setLoading(false);
          return;
        }

        console.log('Found lecturer UUID:', lecturerData.id);

        // Load lecturer assignments using UUID
        const { data: assignmentsData, error: assignmentsError } = await supabase
          .from('lecturer_assignments')
          .select('*')
          .eq('lecturer_id', lecturerData.id);

        if (assignmentsError) {
          console.error('Error loading assignments:', assignmentsError);
          setError(`Failed to load assignments: ${assignmentsError.message}`);
          setLoading(false);
          return;
        }

        if (assignmentsData && assignmentsData.length > 0) {
          console.log('Found assignments:', assignmentsData.length);
          
          // Load course details for each assignment
          const assignmentsWithCourses = await Promise.all(
            assignmentsData.map(async (assignment: any) => {
              const { data: courseData } = await supabase
                .from('courses')
                .select('name, id')
                .eq('id', assignment.course_id)
                .single();

              // Load units for this assignment
              const { data: assignmentUnits } = await supabase
                .from('lecturer_assignment_units')
                .select('unit_code')
                .eq('assignment_id', assignment.id);

              return {
                ...assignment,
                courses: courseData,
                units: assignmentUnits ? assignmentUnits.map((u: any) => u.unit_code) : []
              };
            })
          );

          console.log('Assignments with courses:', assignmentsWithCourses);
          setAssignments(assignmentsWithCourses);
          setViewMode('dashboard');
        } else {
          console.log('No assignments found, showing setup');
          setShowSetup(true);
          setViewMode('setup');
        }
      }
    } catch (err) {
      console.error('Auth check error:', err);
      setError('Failed to load dashboard. Please try again.');
    } finally {
      setLoading(false);
    }
  };

  const handleSetupSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError('');
    setLoading(true);

    try {
      // Get lecturer UUID from lecturer_number
      const { data: lecturerData, error: lecturerError } = await supabase
        .from('lecturers')
        .select('id')
        .eq('lecturer_number', lecturerInfo.lecturer_number || lecturerInfo.id)
        .single();

      if (lecturerError || !lecturerData) {
        console.error('Lecturer lookup error:', lecturerError);
        setError('Lecturer profile not found. Please contact admin.');
        setLoading(false);
        return;
      }

      const lecturerUuid = lecturerData.id;
      console.log('Using lecturer UUID:', lecturerUuid);

      // Create single assignment for this course + campus (no need to wait for students)
      // Check if assignment already exists
      const selectedClass = availableClasses.find(c => c.id === setupData.classId);
      
      const { data: existingAssignment } = await supabase
        .from('lecturer_assignments')
        .select('id')
        .eq('lecturer_id', lecturerUuid)
        .eq('course_id', setupData.course)
        .eq('class_id', setupData.classId)
        .maybeSingle();

      if (existingAssignment) {
        setError('You already have an assignment for this course and class.');
        setLoading(false);
        return;
      }

      // Save lecturer assignment
      const { data: assignmentData, error: assignmentError } = await supabase
        .from('lecturer_assignments')
        .insert([{
          lecturer_id: lecturerUuid,
          class_id: setupData.classId,
          campus: selectedClass?.campus || setupData.campus,
          course_id: setupData.course,
          semester: selectedClass?.semester || 1,
          module_index: selectedClass?.module_index || 1
        }])
        .select()
        .single();

      if (assignmentError) {
        console.error('Error creating assignment:', assignmentError);
        setError(`Failed to create assignment: ${assignmentError.message}`);
        setLoading(false);
        return;
      }

      // Add selected units to assignment
      if (setupData.units.length > 0 && assignmentData) {
        const unitsToInsert = setupData.units.map((unitCode: string) => ({
          assignment_id: assignmentData.id,
          course_id: setupData.course,
          unit_code: unitCode
        }));

        const { error: unitsError } = await supabase
          .from('lecturer_assignment_units')
          .insert(unitsToInsert);

        if (unitsError) {
          console.error('Error adding units to assignment:', unitsError);
        }
      }

      console.log('Created assignment for course:', setupData.course);
      setError('');
      setSuccess(`Successfully assigned to course! Students who apply for this course will be automatically linked to your units.`);
      
      // Reload assignments
      await loadLecturerAssignments(lecturerUuid);
      setShowSetup(false);
    } catch (err: any) {
      console.error('Setup submit error:', err);
      setError(`Failed to setup: ${err?.message || 'Unknown error'}`);
    } finally {
      setLoading(false);
    }
  };

  const handleLogout = async () => {
    await supabase.auth.signOut();
    router.push('/');
  };

  const handleMarksSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError('');
    setLoading(true);

    try {
      // Validate
      if (!marksData.selectedUnit || !marksData.semester || !marksData.examType) {
        setError('Please select a unit, semester, and exam type');
        setLoading(false);
        return;
      }

      if (marksData.marks.length === 0) {
        setError('No student marks to save');
        setLoading(false);
        return;
      }

      // Enforce exam-sitting limits:
      // "combined" (CAT + End Term) counts as one exam,
      // and "mock" counts as one exam.
      const applicationIds = marksData.marks.map((mark) => mark.application_id);
      const { data: studentRows, error: studentRowsError } = await supabase
        .from('applications')
        .select('id, admission_number, course_type')
        .in('id', applicationIds);

      if (studentRowsError) {
        setError(`Failed to validate exam limits: ${studentRowsError.message}`);
        setLoading(false);
        return;
      }

      const { data: courseRow, error: courseRowError } = await supabase
        .from('courses')
        .select(`
          course_types (
            level,
            enabled,
            min_kcse_grade,
            study_mode,
            duration_months,
            modules (
              module_index,
              semesters (
                semester_index,
                duration_months,
                fee,
                practical_fee,
                internal_exams
              )
            )
          )
        `)
        .eq('id', marksData.selectedCourse)
        .single();

      if (courseRowError || !courseRow?.course_types) {
        setError(`Failed to load course setup for exam limits: ${courseRowError?.message || 'Course not found'}`);
        setLoading(false);
        return;
      }

      const { data: existingExamRows, error: existingExamRowsError } = await supabase
        .from('exam_marks')
        .select('application_id, exam_type')
        .eq('course_id', marksData.selectedCourse)
        .eq('unit_code', marksData.selectedUnit)
        .eq('semester', parseInt(marksData.semester))
        .in('application_id', applicationIds);

      if (existingExamRowsError) {
        setError(`Failed to validate existing exam records: ${existingExamRowsError.message}`);
        setLoading(false);
        return;
      }

      const studentTypeMap = new Map<string, string>(
        (studentRows || []).map((row: any) => [row.id, row.course_type || 'diploma'])
      );

      const existingExamTypeMap = new Map<string, Set<string>>();
      (existingExamRows || []).forEach((row: any) => {
        if (!existingExamTypeMap.has(row.application_id)) {
          existingExamTypeMap.set(row.application_id, new Set<string>());
        }
        existingExamTypeMap.get(row.application_id)!.add(row.exam_type);
      });

      for (const mark of marksData.marks) {
        const courseType = studentTypeMap.get(mark.application_id) || 'diploma';
        const typeConfig = getCourseTypeConfig(courseRow.course_types, courseType);

        if (!typeConfig) continue;
        if (typeConfig.studyMode === 'short-course' && !typeConfig.shortCourseHasExams) {
          setError(`${mark.name} (${mark.admission_number}) is in a short course without exams.`);
          setLoading(false);
          return;
        }
        if (typeConfig.studyMode === 'short-course') continue;

        const periodConfig = typeConfig.periods[Math.max(parseInt(marksData.semester) - 1, 0)];
        if (!periodConfig) {
          setError(`${mark.name} (${mark.admission_number}) has no configured period ${marksData.semester} for this course type.`);
          setLoading(false);
          return;
        }
        const allowedExamSittings = Math.max(periodConfig?.internalExams ?? 1, 1);
        const existingTypes = existingExamTypeMap.get(mark.application_id) || new Set<string>();
        const willAddNewType = !existingTypes.has(marksData.examType);
        const resultingSittings = existingTypes.size + (willAddNewType ? 1 : 0);

        if (resultingSittings > allowedExamSittings) {
          setError(
            `${mark.name} (${mark.admission_number}) exceeds allowed exams for this period. Allowed: ${allowedExamSittings}, existing: ${existingTypes.size}.`
          );
          setLoading(false);
          return;
        }
      }

      // Get campus from the selected assignment
      const selectedAssignment = assignments.find(a => a.id === marksData.selectedAssignmentId);
      const campus = selectedAssignment?.campus || '';
      const courseId = selectedAssignment?.course_id || '';

      // Save marks per student: update existing record first, insert if missing
      for (const mark of marksData.marks) {
        // Skip if student is marked absent
        if (mark.absent) {
          continue;
        }

        // Validate marks
        if (marksData.examType === 'combined') {
          const catMarks = mark.cat_marks || 0;
          const endTermMarks = mark.end_term_marks || 0;
          
          if (catMarks < 0 || catMarks > 30) {
            setError(`${mark.name}: CAT marks must be between 0 and 30`);
            setLoading(false);
            return;
          }
          
          if (endTermMarks < 0 || endTermMarks > 70) {
            setError(`${mark.name}: End term marks must be between 0 and 70`);
            setLoading(false);
            return;
          }
        } else {
          const totalMarks = mark.marks || 0;
          if (totalMarks < 0 || totalMarks > 100) {
            setError(`${mark.name}: Marks must be between 0 and 100`);
            setLoading(false);
            return;
          }
        }

        const payload = {
          application_id: mark.application_id,
          campus: campus,
          course_id: courseId,
          unit_code: marksData.selectedUnit,
          semester: parseInt(marksData.semester),
          exam_type: marksData.examType,
          marks: marksData.examType === 'combined' 
            ? (mark.cat_marks || 0) + (mark.end_term_marks || 0) 
            : mark.marks,
          cat_marks: marksData.examType === 'combined' ? (mark.cat_marks || 0) : null,
          end_term_marks: marksData.examType === 'combined' ? (mark.end_term_marks || 0) : null
        };

        const { data: existingRow, error: existingRowError } = await supabase
          .from('exam_marks')
          .select('id')
          .eq('application_id', mark.application_id)
          .eq('course_id', courseId)
          .eq('unit_code', marksData.selectedUnit)
          .eq('semester', parseInt(marksData.semester))
          .eq('exam_type', marksData.examType)
          .maybeSingle();

        if (existingRowError) {
          setError(`Failed to check existing marks: ${existingRowError.message}`);
          setLoading(false);
          return;
        }

        if (existingRow?.id) {
          const { error: updateError } = await supabase.from('exam_marks').update(payload).eq('id', existingRow.id);
